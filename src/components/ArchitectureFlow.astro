---
import { architectureFlow } from "../data/portfolio";
---

<figure class="arch">
  <h3>Closed-loop verification flow</h3>
  <figcaption class="arch-caption">{architectureFlow.caption}</figcaption>
  <ol class="arch-flow">
    {
      architectureFlow.stages.map((stage, index) => (
        <li class="arch-step">
          <span class="arch-index">{String(index + 1).padStart(2, "0")}</span>
          <span class="arch-label">{stage}</span>
        </li>
      ))
    }
  </ol>
  <svg class="arch-svg" viewBox="0 0 1100 28" role="img" aria-hidden="true">
    <title>Sequence from recommendation through learning</title>
    <line x1="20" y1="14" x2="1080" y2="14" stroke="#c9c4bb" stroke-width="1.5" />
    {
      [20, 232, 444, 656, 868, 1080].map((x) => (
        <circle cx={x} cy="14" r="5" fill="#1e4d8c" />
      ))
    }
  </svg>
</figure>
